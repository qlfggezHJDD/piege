# ─────────────────────────────────────────────────
#   PIÈGE À RAT BOT — Variables d'environnement
#   Copier ce fichier en .env et remplir les valeurs
# ─────────────────────────────────────────────────

# Token du bot Discord (obligatoire)
# → Discord Developer Portal > Applications > Ton bot > Bot > Token
DISCORD_TOKEN=METS_TON_TOKEN_ICI

# ID du salon piège (obligatoire)
# → Paramètres Discord : Mode développeur activé, clic droit sur le salon > Copier l'ID
HONEYPOT_CHANNEL_ID=ID_DU_SALON_PIEGE

# ID du salon où le bot poste les logs (optionnel mais recommandé)
LOG_CHANNEL_ID=ID_DU_SALON_LOGS

# IDs de rôles qui ne seront JAMAIS sanctionnés (séparés par des virgules)
# Utile pour protéger des rôles spéciaux en plus des admins/modos
WHITELIST_ROLE_IDS=ID_ROLE_1,ID_ROLE_2
